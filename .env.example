# Copy this file to .env.local and fill in the values from your own
# Supabase project (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Only needed for server-side edge functions / scripts that must bypass
# Row Level Security (e.g. the pill-label-scanning function). Never expose
# this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Used by the pill-bottle scanning edge function (Google AI Studio key).
GEMINI_API_KEY=YOUR-GEMINI-API-KEY

# Used by the edge function that sends real-time email alerts to family
# members when a senior triggers SOS or misses medication.
RESEND_API_KEY=YOUR-RESEND-API-KEY
